{
  "name": "@puppygraph/mcp-server",
  "version": "1.2.0",
  "description": "Model Context Protocol (MCP) server for PuppyGraph: lets AI agents query your graph with Cypher and Gremlin",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "puppygraph",
    "graph",
    "cypher",
    "gremlin",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/puppygraph/puppygraph-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/puppygraph/puppygraph-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppygraph/puppygraph-mcp-server.git"
  },
  "license": "Apache-2.0",
  "author": "PuppyGraph",
  "type": "module",
  "bin": {
    "puppygraph-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "npm run build && vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "gremlin": "^3.8.1",
    "neo4j-driver": "^5.28.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "msw": "^2.1.4",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "gremlin": {
      "uuid": "11.1.1",
      "ws": "8.21.3"
    }
  }
}
